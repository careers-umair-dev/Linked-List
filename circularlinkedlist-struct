// 11. Update first matching value
void updateValue(int oldValue, int newValue)
{
    if (head == nullptr)
    {
        cout << "List is empty.\n";
        return;
    }

    Node* temp = head;

    do
    {
        if (temp->data == oldValue)
        {
            temp->data = newValue;
            cout << "Value updated successfully.\n";
            return;
        }

        temp = temp->next;

    } while (temp != head);

    cout << "Value not found.\n";
}

// 12. Reverse list
void reverseList()
{
    if (head == nullptr || head->next == head)
    {
        cout << "List reversed successfully.\n";
        return;
    }

    Node* previous = head;
    Node* current = head->next;
    Node* nextNode;

    while (current != head)
    {
        nextNode = current->next;
        current->next = previous;
        previous = current;
        current = nextNode;
    }

    head->next = previous;
    head = previous;

    cout << "List reversed successfully.\n";
}

// 13. Find maximum value
void findMaximum()
{
    if (head == nullptr)
    {
        cout << "List is empty.\n";
        return;
    }

    int maximum = head->data;
    Node* temp = head->next;

    while (temp != head)
    {
        if (temp->data > maximum)
        {
            maximum = temp->data;
        }

        temp = temp->next;
    }

    cout << "Maximum value: " << maximum << "\n";
}

// 14. Find minimum value
void findMinimum()
{
    if (head == nullptr)
    {
        cout << "List is empty.\n";
        return;
    }

    int minimum = head->data;
    Node* temp = head->next;

    while (temp != head)
    {
        if (temp->data < minimum)
        {
            minimum = temp->data;
        }

        temp = temp->next;
    }

    cout << "Minimum value: " << minimum << "\n";
}

// 15. Sort list in ascending order
void sortList()
{
    if (head == nullptr || head->next == head)
    {
        cout << "List is already sorted.\n";
        return;
    }

    Node* current = head;

    do
    {
        Node* index = current->next;

        while (index != head)
        {
            if (current->data > index->data)
            {
                int temp = current->data;
                current->data = index->data;
                index->data = temp;
            }

            index = index->next;
        }

        current = current->next;

    } while (current->next != head);

    cout << "List sorted in ascending order.\n";
}

// 16. Remove duplicate values
void removeDuplicates()
{
    if (head == nullptr || head->next == head)
    {
        cout << "Duplicate values removed.\n";
        return;
    }

    Node* current = head;

    do
    {
        Node* previous = current;
        Node* temp = current->next;

        while (temp != head)
        {
            if (temp->data == current->data)
            {
                Node* del = temp;
                previous->next = temp->next;
                temp = temp->next;
                delete del;
            }
            else
            {
                previous = temp;
                temp = temp->next;
            }
        }

        current = current->next;

    } while (current != head);

    cout << "Duplicate values removed.\n";
}

// 17. Find middle node
void findMiddle()
{
    if (head == nullptr)
    {
        cout << "List is empty.\n";
        return;
    }

    Node* slow = head;
    Node* fast = head;

    while (fast->next != head &&
           fast->next->next != head)
    {
        slow = slow->next;
        fast = fast->next->next;
    }

    cout << "Middle value: " << slow->data << "\n";
}

// 18. Clear entire list
void clearList()
{
    while (head != nullptr)
    {
        if (head->next == head)
        {
            delete head;
            head = nullptr;
        }
        else
        {
            Node* temp = head;
            Node* last = head;

            while (last->next != head)
            {
                last = last->next;
            }

            head = head->next;
            last->next = head;

            delete temp;
        }
    }

    cout << "All nodes deleted.\n";
}

